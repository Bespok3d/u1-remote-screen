{
  "name": "remote-screen",
  "title": "Remote Screen",
  "version": "0.1.21",
  "author": "bespoked",
  "min_daemon_version": "0.10.1-dev",
  "description": "Mirror the printer's on-device touchscreen to a browser. Low-overhead framebuffer capture, no UI changes on the device side.\n\nThe screen also appears as a tile inside Fluidd and Mainsail, alongside your cameras, with no manual setup: the plugin registers the mirror as a Moonraker [webcam] iframe entry sized for the U1's 480:320 display. You pick the name it shows under when you install it.",
  "tagline": "Stream your printer's framebuffer as MJPEG.",
  "category": "screen",
  "channel": "stable",
  "printer_specific": true,
  "changelog": "doc/CHANGELOG.md",
  "published_at": "2025-07-30",
  "updated_at": "2026-07-27",
  "source": "https://github.com/bespok3d-org/plugin-remote-screen",
  "publisher": "PLACEHOLDER",
  "provides": [
    {
      "service": "screen-service"
    }
  ],
  "require": [],
  "conflicts": [
    "webcam-screen"
  ],
  "requires": {
    "capabilities": [
      "klipper-generic"
    ],
    "variables": [
      {
        "name": "REMOTE_SCREEN_NAME",
        "description": "Display name for the on-device screen mirror in Fluidd/Mainsail (e.g. \"Screen\", \"Printer Screen\", \"UI\").",
        "required": true
      }
    ]
  },
  "config": [
    {
      "key": "REMOTE_SCREEN_NAME",
      "label": "Screen name in Fluidd/Mainsail",
      "type": "text",
      "placeholder": "Printer Screen",
      "default": "Printer Screen",
      "hint": "Letters, numbers, spaces, and . - : / _ @ only.",
      "required": true,
      "userEditable": true
    }
  ],
  "permissions": [
    "web-location",
    "managed-service",
    "moonraker-config",
    "restart"
  ],
  "install": {
    "place": [
      {
        "class": "web-location",
        "src": "files/etc/nginx/locations/remote-screen.conf"
      },
      {
        "class": "moonraker-config",
        "src": "files/webcam.conf.tmpl",
        "name": "remote-screen.cfg",
        "render": true
      }
    ],
    "service": [
      {
        "name": "remote-screen",
        "command": "/usr/bin/python3",
        "args": [
          "-u",
          "$BESPOK3D_PLUGINS/remote-screen/files/bin/remote-screen.py",
          "--bind",
          "127.0.0.1",
          "--port",
          "8092",
          "--html-dir",
          "$BESPOK3D_PLUGINS/remote-screen/files/html",
          "--trace",
          "$BESPOK3D/var/log/remote-screen-trace.log"
        ],
        "autostart": true,
        "ports": [
          8092
        ]
      }
    ],
    "restart": [
      "web",
      "moonraker"
    ]
  },
  "endpoints": [
    {
      "label": "Remote screen",
      "path": "/screen/"
    }
  ],
  "conflict_resolutions": [],
  "files": []
}
